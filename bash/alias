# custom commands
#-----------------------------------------------------

alias python='python3'

alias pip='pip3'

alias l='ls -lAh'

alias al='vim ~/bin/mc-dotfiles/bash/alias'

alias vhost='sudo vim /etc/hosts'

# cheat sheets (xdg-open = Linux's "open")
CHEAT=~/bin/mc-dotfiles/cheat

alias cschmod="xdg-open $CHEAT/cs-chmod.png"

alias csmd="xdg-open $CHEAT/cs-md.pdf"

alias csreg="xdg-open $CHEAT/cs-regex.jpg"

alias csvim="xdg-open $CHEAT/cs-vim.jpg"

alias csvenv="xdg-open $CHEAT/cs-venv.png"

alias csnerd="xdg-open $CHEAT/cs-nerd.pdf"

alias csng="xdg-open $CHEAT/cs-ng.pdf"

alias csws="xdg-open $CHEAT/cs-webstorm.png"

alias csex="xdg-open $CHEAT/cs-excel.pdf"

alias csvs="xdg-open $CHEAT/cs-vscode.pdf"

alias cstmux="xdg-open $CHEAT/cs-tmux.png"

alias cscl="xdg-open $CHEAT/cs-claude.png"

alias cscc="xdg-open $CHEAT/cs-tmux-claude.png"

alias dwn='cd ~/Downloads'

alias add-ssh='ssh-add ~/.ssh/mc_ubuntu'

alias flush='resolvectl flush-caches'

alias ppro='ping www.cotopaxi.com'

alias aliens='cat ~/bin/mc-dotfiles/bash/alias'

alias aptup='sudo apt update && sudo apt upgrade'

# py virtualenv commands

alias aenv='deactivate &> /dev/null; source ./venv/bin/activate'

alias denv='deactivate'

# node nodeenv commands

alias naenv='. env/bin/activate'

alias ndenv='deactivate_node'


# custom functions
#-----------------------------------------------------

function clprj() { cd ~/Documents/Claude/Projects/"$1" && ls ; }

function dot() { cd ~/bin/mc-dotfiles/"$1" && l ; }

function drp() { cd ~/Dropbox/"$1" && ls ; }

function dt() { cd ~/Desktop/"$1" && ls ; }

function nav() { http-server ~/Desktop/ ; }

function sklz() { cd ~/.claude/skills/"$1" && ls ; }

function src() { cd ~/Documents/Source/"$1" && ls ; }

function vault() { cd ~/Documents/Source/vault/"$1" && ls ; }

function to() { touch "$1" && vim "$1" ; }

function tod() { mkdir "$1" && cd "$1" ; }

function wsp() { cd ~/Documents/Workspace/"$1" && ls ; }

function pypr() { cd ~/Documents/Source/py/"$1" && ls ; }

function ytaudio() { yt-dlp -f 140 "$1" ; }
